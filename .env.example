# TEMPLATE LANG ITO — kopyahin bilang `.env` sa project root, at doon ilagay ang tunay na keys.
# Ang `.env` ay naka-gitignore: HINDI ito dapat i-commit o i-push kailanman.
#
# Saan kunin ang values:
#   Supabase Dashboard → piliin ang project → Project Settings → API keys
#     - Project URL      → VITE_SUPABASE_URL
#     - anon public key  → VITE_SUPABASE_ANON_KEY
#
# Pagkatapos baguhin ang `.env`: i-restart ang `npm run dev`, o mag-run ng `npm run build`.
# Para sa Netlify: ilagay ang parehong variables sa
#   Site configuration → Environment variables, pagkatapos ay mag-trigger ng bagong deploy.

VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-KEY

# Admin console (#/admin): comma-separated list ng mga email na pwedeng mag-login.
# NOTE: UX-level gate lang ito — ang tunay na security ay ang Supabase RLS policies
# (supabase/admin_setup.sql) + ang admin_users table. Kung wala ito, default:
# support@redirectioninnovation.com
VITE_ADMIN_EMAILS=support@redirectioninnovation.com